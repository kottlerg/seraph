# test-fault: the test-only `test-fault` fixtures on QEMU's `pci-testdev`
# functions, bound on demand (`BIND_DRIVERS`).
#
# The fixture checks no badge bit; a class names at least one verb bit, so
# the SEND carries bit 63. svcmgr publishes it seed-only as
# `devmgr.class.test-fault`, which only svctest seeds. Test-only: this
# directory is not scanned; the svctest recipe copies the file into
# /config/devmgr/classes/ (docs/testing.md).
verbs = 63
