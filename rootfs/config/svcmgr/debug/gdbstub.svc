# /services/gdbstub — the GDB stub's recipe template.
#
# Lives under /config/svcmgr/debug/, which svcmgr does NOT scan: an image
# that does not stage the stub has no attach path through it. `cargo xtask
# run --debug-port PORT --debug-target NAME` (and `test-gdb`) writes it into
# /config/svcmgr/services/ with the target's name appended to `argv`, and
# repacks disk.img. See services/gdbstub/README.md.
#
# seed = devmgr.debug is the DEBUG_PORT_AUTHORITY SEND for the debug port;
# `debug_authority = yes` makes svcmgr deliver a DEBUG_AUTHORITY SEND on
# procmgr in the bootstrap slot after it, for LIST_PROCESSES, ATTACH_PROCESS,
# and DETACH_PROCESS.
binary          = /services/gdbstub
argv            = gdbstub
priority        = 15
restart         = never
critical        = no
namespace       = none
seed            = devmgr.debug
debug_authority = yes
