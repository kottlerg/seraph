# crashd — the crash service.
#
# crashd reports each process that dies on a fault to the system log, as one
# marked block (services/crashd/docs/block-format.md). `debug_authority =
# yes` makes svcmgr mint a DEBUG_AUTHORITY SEND|GRANT on procmgr and deliver
# it in the bootstrap slot after the seeds (cap[2] here, after the RECV
# `provides` delivers and the one seed): crashd registers with it as the
# receiver of procmgr's crash endpoint, attaches to each faulting process,
# and asks procmgr for the snapshot a live core is written from. Removing this recipe from the image
# removes the reports: procmgr then declines every fault on that endpoint,
# and a fault kills as it does with no handler.
#
# `restart = on_failure`: procmgr declines the faults that arrive while crashd
# is down, and hands the endpoint to the respawned crashd when it registers.
# `critical = no`: without crashd the system runs, unreported.
#
# `reserve = yes` makes crashd's budget node a system-reserve node, which
# may take the free pages memmgr keeps in reserve, so crashd can report and
# dump a fault memmgr declined for want of memory while the free pool is
# spent. A reserve holder has a core role: no stop-authority holder may stop
# crashd.
#
# `provides = crashd.core:grant` makes svcmgr create crashd's live-core
# endpoint and publish one SEND on it, seed-only, carrying the authority to
# ask for a live core: an ELF core of a process that keeps running
# (services/crashd/docs/operation.md § Live Core). It is `:grant` because the
# request moves the memmgr account the capture is charged to. No recipe here
# seeds it; a recipe that seeds it can copy any live process's memory.
#
# `CORE_DUMP` names the processes whose faults leave an ELF core in /crash:
# `no` (the default) writes none, a comma-separated list of process names
# writes one for each process named (services/crashd/docs/operation.md
# § Core Dump). The namespace grants /crash alone, with the rights the core
# store uses (create, write, list, size, delete, rename) and not READ: a
# core holds the process's memory, so reading one needs a cap to /crash.
#
# `CRASHD_OOM_STALL_MS` holds a fault memmgr declined for want of memory for up
# to 10000 ms (services/crashd/docs/operation.md § Hold): longer than oomd's
# grace and cooldown together (services/oomd.svc), so a fault held from the
# level's rise outlasts oomd's first two stops, and resumes when either frees
# memory; a later stop finds it reported and declined.
# `seed = logd.flush` delivers cap[1]: the LOG_FLUSH_AUTHORITY-badged SEND
# on logd's master log endpoint, which carries logd's flush barrier and no
# other authority (services/logd/docs/ipc-interface.md § Flush barrier).
# crashd waits on it after a report and before it declines the fault, within
# the report's bound, since the decline can kill logd itself and the lines
# logd has taken but not written die with it. Without it, crashd declines
# without the wait.
binary          = /services/crashd
priority        = 20
restart         = on_failure
critical        = no
provides        = crashd.core:grant
seed            = logd.flush
env             = CORE_DUMP=no CRASHD_OOM_STALL_MS=10000
namespace       = subtree:/crash:LOOKUP+READDIR+STAT+WRITE+MUTATE_DIR
debug_authority = yes
reserve         = yes
