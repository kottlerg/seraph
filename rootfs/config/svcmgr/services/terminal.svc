# /programs/terminal — userspace terminal (v0.0.1, #111).
#
# Autostarts on a normal boot. Relays the virtio-input keyboard to the stdin of
# an operator session's leader and the leader's stdout to the framebuffer +
# serial TX, with a minimal line discipline (local echo, single-line
# backspace, CR->LF). It is never in the ESP bundle and init never loads it.
#
# The terminal is an interface of sessiond (docs/session-supervision.md): it
# opens its session through the sessiond.operator SEND, and sessiond creates
# the leader (the shell sessiond's recipe names), so the terminal holds no
# process handle and needs no namespace. sessiond ends the terminal's sessions
# when the terminal ends, whatever ends it, so svcmgr supervises it:
# `restart = on_failure`, `critical = no`.
#
# The seeds are the input, framebuffer, and serial class SENDs, each queried
# with QUERY_DEVICE, and the sessiond.operator SEND, in that order.
binary    = /programs/terminal
priority  = 10
sched_max = 10
argv      = terminal
restart   = on_failure
critical  = no
namespace = none
seed      = devmgr.class.input devmgr.class.framebuffer devmgr.class.serial sessiond.operator
