# /tests/debug-echo — the debug port's transport fixture.
#
# Recipe lives under /config/svcmgr/tests/, which svcmgr does NOT scan.
# `cargo xtask test-debug-port` stages it into /config/svcmgr/services/ for
# one boot with `--debug-port`, which attaches the virtio-console device
# devmgr binds as the debug port. See services/debug-echo/README.md.
#
# seed = devmgr.debug is the DEBUG_PORT_AUTHORITY SEND used for
# QUERY_DEBUG_PORT_DEVICE. It invokes no shutdown: the host test kills QEMU.
binary    = /tests/debug-echo
argv      = debug-echo
restart   = never
critical  = no
namespace = none
seed      = devmgr.debug
