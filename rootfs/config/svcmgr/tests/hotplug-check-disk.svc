# /tests/fixtures/hotplug-check, disk mode — the fixture of the `hotplug` case's storage
# boots: a disk hot-added, removed and added again behind the root port,
# a copy of it added behind the second port, and the loss of the root
# filesystem's driver.
#
# Recipe lives under /config/svcmgr/tests/, which svcmgr does NOT scan.
# the `hotplug` case stages it into /config/svcmgr/services/ for
# its storage boots, which hold the data image for the port. See
# services/fixtures/hotplug-check/README.md.
#
# seed = vfsd.mount is the MOUNT_AUTHORITY SEND on vfsd's service endpoint
# the fixture mounts the hot-added disk's data partition through.
# debug_authority = yes delivers procmgr's DEBUG_AUTHORITY SEND|GRANT in the
# slot after the seed, which the fixture finds the root mount's driver
# (LIST_PROCESSES), stops and kills it through (ATTACH_PROCESS); as every
# holder, it declares itself undebuggable at startup. namespace = universal
# gives it the system root, which crosses mounts, for the files it writes
# and reads under /data. It invokes no shutdown: the kill of the root driver
# ends vfsd, and svcmgr shuts the system down.
binary    = /tests/fixtures/hotplug-check
argv      = hotplug-check disk
restart   = never
critical  = no
namespace = universal
seed      = vfsd.mount
debug_authority = yes
