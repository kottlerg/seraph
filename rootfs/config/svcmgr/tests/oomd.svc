# /config/svcmgr/tests/oomd.svc — oomd with a 1000 ms cooldown for svctest.
#
# Recipe lives under /config/svcmgr/tests/, which svcmgr does NOT scan.
# `cargo xtask mkdisk --svctest <set>` stages it over
# /config/svcmgr/services/oomd.svc for every set, so svctest's phases that
# wait out oomd's acts (oom_policy's stop order, crashd_oom_hold) wait one
# cooldown of 1000 ms per act instead of the default's 5000. See
# docs/testing.md § Gating.
#
# The same recipe as services/oomd.svc but for `OOMD_COOLDOWN_MS`: the grace
# and the stop mode are the default's. crashd's svctest recipe
# (tests/crashd.svc) holds a fault for longer than this grace and cooldown
# together, as the defaults do. xtask's svctest_stage tests hold the recipe to
# the default but for that value.
binary          = /services/oomd
priority        = 20
restart         = on_failure
critical        = no
env             = OOMD_GRACE_MS=2000 OOMD_COOLDOWN_MS=1000 OOMD_STOP=yes
namespace       = none
stop_authority  = yes
reserve         = yes
