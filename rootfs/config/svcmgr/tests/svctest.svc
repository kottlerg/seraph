# /tests/svctest — services-surface test harness.
#
# One-shot: exits cleanly on completion; svcmgr never restarts it.
# Seeds resolve through svcmgr's discovery registry, each seed-only (no
# QUERY_ENDPOINT reaches them): rootfs.root is the FS-driver-agnostic
# root-mount cap; pwrmgr.shutdown is the SHUTDOWN_AUTHORITY-tokened SEND;
# devmgr.registry is the REGISTRY_QUERY_AUTHORITY SEND the devmgr deny
# phases send the gated labels on; devmgr.bind is the
# REGISTRY_QUERY_AUTHORITY | BIND_AUTHORITY SEND|GRANT the devmgr
# on-demand bind phase sends BIND_DRIVERS on, with a cap on /tests/drivers;
# vfsd.mount is the MOUNT_AUTHORITY SEND on vfsd's service endpoint the
# vfsd phases drive MOUNT's rejection paths with, and vfsd.deny its
# no-authority twin. The vfsd seeds ride in a second bootstrap round, so
# every svctest boot exercises a seed list longer than one round; the
# svcmgr_second_seed_round phase fails the run if they do not arrive.
# logd.query is the LOG_QUERY_AUTHORITY SEND on the master log endpoint the
# logd_death_forward phase reads its dead child's retired slot through.
# devmgr.class.serial and devmgr.class.input are the class SENDs the
# drivers stray-cap phase and the devmgr ordinal phase query devices on.
# devmgr.class.test-dma and devmgr.class.test-fault reach the test-only
# fixtures, and devmgr.class.{serial,input,framebuffer}-deny are SENDs on
# those classes whose only verb bit (58) no such driver checks, which the
# drivers deny phase sends the gated labels on. Their class files live in
# /config/devmgr/tests/, which svcmgr does not scan, and are copied into
# /config/devmgr/classes/ with this recipe; the fixtures' devices are
# attached by `cargo xtask run --test-devices`.
# svctest resolves the public pwrmgr.deny no-auth twin itself via
# QUERY_ENDPOINT. debug_authority = yes delivers procmgr's
# DEBUG_AUTHORITY SEND|GRANT in the slot after the seeds, and svctest,
# as every holder, declares itself undebuggable at startup; the
# crash_endpoint phase registers with it as the crash service, which the
# svctest boot, staging no crashd, leaves free (burn-in's svctest cell
# stages crashd, and the phase then checks only the refusal).
#
# Recipe lives under /config/svcmgr/tests/, which svcmgr does NOT
# scan. To enable in a boot, copy this file into
# /config/svcmgr/services/, and the test class files above into
# /config/devmgr/classes/, between `cargo xtask build` and
# `cargo xtask run --test-devices`. See docs/testing.md.
#
# svctest runs at 10, in the fair class. Its band reaches 21, the floor of
# the strict-priority class and svcmgr's own ceiling, so the
# heap_lock_priority_contention phase can place one thread above the fair
# class.
binary    = /tests/svctest
priority  = 10
sched_max = 21
argv      = svctest run
env       = SERAPH_TEST=1 SERAPH_MODE=boot
restart   = never
critical  = no
namespace = universal
cwd       = /data
seed      = rootfs.root pwrmgr.shutdown devmgr.registry devmgr.bind vfsd.mount vfsd.deny logd.query devmgr.class.serial devmgr.class.input devmgr.class.test-dma devmgr.class.test-fault devmgr.class.serial-deny devmgr.class.input-deny devmgr.class.framebuffer-deny
debug_authority = yes
