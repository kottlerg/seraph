# /tests/svctest — services-surface test harness.
#
# One-shot: exits cleanly on completion; svcmgr never restarts it.
# Seeds resolve through svcmgr's discovery registry, each seed-only (no
# QUERY_ENDPOINT reaches them): rootfs.root is the SEND on vfsd's
# synthetic root, which crosses mounts; pwrmgr.shutdown is the
# SHUTDOWN_AUTHORITY-tokened SEND;
# devmgr.registry is the REGISTRY_QUERY_AUTHORITY SEND the devmgr deny
# phases send the gated labels on; devmgr.bind is the
# REGISTRY_QUERY_AUTHORITY | BIND_AUTHORITY SEND|GRANT the devmgr
# on-demand bind phase sends BIND_DRIVERS on, with a cap on /tests/drivers;
# vfsd.mount is the MOUNT_AUTHORITY SEND on vfsd's service endpoint the
# vfsd phases drive MOUNT's rejection paths with and the unmount phases
# UNMOUNT and their remounts, and vfsd.deny its no-authority twin. Those
# two vfsd seeds ride in a second bootstrap round, so
# every svctest boot exercises a seed list longer than one round; the
# svcmgr_second_seed_round phase fails the run if they do not arrive.
# logd.query is the LOG_QUERY_AUTHORITY SEND on the master log endpoint the
# logd_death_forward phase reads its dead child's retired slot through, and
# the logd_restart and logd_sinks phases read logd's history through.
# devmgr.class.serial and devmgr.class.input are the class SENDs the
# drivers stray-cap phase and the devmgr ordinal phase query devices on.
# devmgr.class.test-dma and devmgr.class.test-fault reach the test-only
# fixtures, and devmgr.class.{serial,input,framebuffer}-deny are SENDs on
# those classes whose only verb bit (58) no such driver checks, which the
# drivers deny phase sends the gated labels on; the drivers stray-cap
# phase floods the framebuffer driver through framebuffer-deny, and the
# logd_sinks phase waits on it for the killed framebuffer driver's
# withdrawal. Their class files live in
# /config/devmgr/tests/, which svcmgr does not scan, and are copied into
# /config/devmgr/classes/ with this recipe; the fixtures' devices are
# attached by `cargo xtask run --test-devices`.
# vfsd.swap is the SWAP_AUTHORITY SEND on vfsd's service endpoint on
# which the vfsd_swap_partition phase drives GET_SWAP_PARTITION. svctest
# seeds it, as swapd's recipe does, to drive only the stale-version
# refusal of GET_SWAP_PARTITION (LABEL_VERSION_MISMATCH), which hands
# nothing out: a hand-out to svctest would revoke swapd's partition cap.
# sessiond.operator is the OPERATOR_AUTHORITY SEND on sessiond's service
# endpoint, through which the sessiond_operator and oom_policy phases open
# operator sessions as an interface.
# devmgr.class.hwrng is the class SEND the drivers hwrng read phase and
# the drivers stray-cap phase read the hardware RNG driver through, and
# devmgr.class.hwrng-deny its twin whose only verb bit (58) no such
# driver checks, which the drivers deny phase sends READ on; its class
# file lives in /config/devmgr/tests/ with the other deny classes.
# memmgr.swap is memmgr's SWAP_AUTHORITY SEND|GRANT, through which the
# memmgr_swap_client, memmgr_swap_raw and swapd phases act as a swap client
# over a RAM slot store.
# swapd's recipe seeds it too; svctest is a second swap client beside swapd
# that takes and restores chunks of its own and registers nothing, since a
# registration would replace swapd's.
# devmgr.class.rtc is the class SEND the rtc_create_retry phase queries
# for devmgr's service of the RTC driver its create retry started, before
# the timed_rtc_restart phase kills that driver, and the drivers stray-cap
# phase floods the RTC driver through.
# svctest resolves the public pwrmgr.deny no-auth twin itself via
# QUERY_ENDPOINT. debug_authority = yes delivers procmgr's
# DEBUG_AUTHORITY SEND|GRANT in the slot after the seeds, and svctest,
# as every holder, declares itself undebuggable at startup; the
# crash_endpoint phase registers with it as the crash service, which the
# svctest boot, staging no crashd, leaves free (burn-in's svctest cell
# stages crashd, and the phase then checks only the refusal); the
# logd_restart phase kills logd through an attach with it, and the
# logd_sinks phase stops the serial and framebuffer drivers and kills the
# framebuffer driver the same way.
# stop_authority = yes delivers svcmgr's STOP_AUTHORITY SEND in the slot
# after that, through which the svcmgr_stop_service phase stops and lists
# services and lists the stop sources.
#
# Recipe lives under /config/svcmgr/tests/, which svcmgr does NOT
# scan. To enable in a boot, copy this file into
# /config/svcmgr/services/, and the test class files above into
# /config/devmgr/classes/, between `cargo xtask build` and
# `cargo xtask run --test-devices`. See docs/testing.md.
#
# svctest runs at 10, in the fair class. Its band reaches 21, the floor of
# the strict-priority class and svcmgr's own ceiling, so the
# heap_lock_priority_contention phase can place one thread above the fair
# class.
binary    = /tests/svctest
priority  = 10
sched_max = 21
argv      = svctest run
env       = SERAPH_TEST=1 SERAPH_MODE=boot
restart   = never
critical  = no
namespace = universal
cwd       = /data
seed      = rootfs.root pwrmgr.shutdown devmgr.registry devmgr.bind vfsd.mount vfsd.deny logd.query devmgr.class.serial devmgr.class.input devmgr.class.test-dma devmgr.class.test-fault devmgr.class.serial-deny devmgr.class.input-deny devmgr.class.framebuffer-deny vfsd.swap sessiond.operator devmgr.class.hwrng devmgr.class.hwrng-deny memmgr.swap devmgr.class.rtc
debug_authority = yes
stop_authority  = yes
