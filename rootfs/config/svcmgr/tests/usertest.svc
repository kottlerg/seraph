# /tests/usertest — programs-surface test orchestrator.
#
# One-shot: exits cleanly on completion; svcmgr never restarts it. The
# orchestrator walks /tests/programs/, spawns each per-program tester
# sequentially, then powers off via the pwrmgr.shutdown seed.
#
# The later seeds are authorities testers take: TESTER_SEEDS names, per
# tester, the seed slots usertest hands it as its bootstrap caps (slot 0,
# pwrmgr.shutdown, is usertest's own). The hello tester takes pwrmgr.deny to
# check the delivery. See docs/testing.md § Per-program tester protocol.
#
# Recipe lives under /config/svcmgr/tests/, which svcmgr does NOT scan.
# To enable in a boot, copy this file into /config/svcmgr/services/
# between `cargo xtask build` and `cargo xtask run`. See docs/testing.md.
binary    = /tests/usertest
priority  = 10
sched_max = 10
argv      = usertest
restart   = never
critical  = no
namespace = universal
cwd       = /data
env       = TESTER_SEEDS=hello:1
seed      = pwrmgr.shutdown pwrmgr.deny
